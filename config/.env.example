# Voicsito — Environment Template
# Copy to config/.env and fill in. Never commit the real .env.

# ==========================================
# GoHighLevel — Private Integration Tokens
# ==========================================
GHL_MAIN_CRM_PIT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_TEXTS_CRM_1_PIT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_TEXTS_CRM_2_PIT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

GHL_MAIN_CRM_LOCATION_ID=
GHL_TEXTS_CRM_1_LOCATION_ID=
GHL_TEXTS_CRM_2_LOCATION_ID=

# ==========================================
# AI Services
# ==========================================
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ==========================================
# Telephony
# ==========================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_SIP_DOMAIN=voicsito.sip.twilio.com
TWILIO_SIP_DID=+1...

# ==========================================
# Storage
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_RECORDINGS=voicsito-recordings

# ==========================================
# VPS
# ==========================================
VPS_HOST=
VPS_USER=root
VPS_SSH_KEY_PATH=~/.ssh/voicsito_vps

# ==========================================
# Sales Dashboard
# ==========================================
SALES_DASHBOARD_WEBHOOK_URL=
SALES_DASHBOARD_WEBHOOK_TOKEN=

# ==========================================

# ==========================================
# Postgres / Redis
# ==========================================
POSTGRES_URL=postgresql://voicsito:CHANGE_ME@localhost:5432/voicsito
REDIS_URL=redis://localhost:6379/0
VAPI_API_KEY=
