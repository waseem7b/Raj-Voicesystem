            "type": "string"
          },
          "business_name": {
            "description": "Prospect's business / company name.",
            "type": "string"
          },
          "prospect_first_name": {
            "description": "Prospect's first name.",
            "type": "string"
          }
        },
        "required": [
          "slot_iso",
          "email",
          "prospect_first_name"
        ]
